PORT=4000

LOG_LEVEL=log
LOG_MAX_FILE_SIZE=1024

CRYPT_SALT=10
JWT_SECRET_KEY=secret123123
JWT_SECRET_REFRESH_KEY=secret123123
TOKEN_EXPIRE_TIME=1h
TOKEN_REFRESH_EXPIRE_TIME=24h

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_hub
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# External port exposed on host (used when running app locally against Docker DB)
POSTGRES_EXTERNAL_PORT=5432

# Local app + Docker DB (use POSTGRES_EXTERNAL_PORT):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge_hub?schema=public&connection_limit=10&pool_timeout=20
# Docker app + Docker DB (use service hostname 'db'):
# DATABASE_URL=postgresql://postgres:postgres@db:5432/knowledge_hub?schema=public&connection_limit=10&pool_timeout=20

# AI / Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_RATE_LIMIT_RPM=20
AI_CACHE_TTL_SEC=300

# RAG — Vector DB (Qdrant)
RAG_VECTOR_DB_URL=http://vectordb:6333
RAG_VECTOR_COLLECTION=knowledge_hub_articles
QDRANT_EXTERNAL_PORT=6333

# RAG — Chunking
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=200

# RAG — Conversation memory
RAG_CONVERSATION_MAX_MESSAGES=20
