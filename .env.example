PORT=4000

CRYPT_SALT=10
JWT_SECRET_KEY=secret123123
JWT_SECRET_REFRESH_KEY=secret123123
TOKEN_EXPIRE_TIME=1h
TOKEN_REFRESH_EXPIRE_TIME=24h

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_hub
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# External port exposed on host (used when running app locally against Docker DB)
POSTGRES_EXTERNAL_PORT=5432

# Local app + Docker DB (use POSTGRES_EXTERNAL_PORT):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge_hub?schema=public&connection_limit=10&pool_timeout=20
# Docker app + Docker DB (use service hostname 'db'):
# DATABASE_URL=postgresql://postgres:postgres@db:5432/knowledge_hub?schema=public&connection_limit=10&pool_timeout=20
